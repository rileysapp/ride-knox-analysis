<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="part1.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1111"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="stations" custom_title="0" dock_id="2" table="4,8:mainstations"/><dock_state state="000000ff00000000fd00000001000000020000015c000002aefc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000000000000000fb000000160064006f0063006b00420072006f007700730065003201000000000000015c0000011e00ffffff0000015c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="stations" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="85"/><column index="2" value="202"/><column index="3" value="140"/><column index="4" value="70"/><column index="5" value="78"/><column index="6" value="46"/><column index="7" value="117"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT
 	COUNT(*) AS all_stations,
    ROUND(AVG(docks), 1) AS average_docks_per_station,
    MIN(docks) AS smallest_station,
    MAX(docks) AS largest_station
FROM stations;

SELECT
    COUNT(*) AS all_trips,
    ROUND(AVG((julianday(end_time) - julianday(start_time)) * 24), 2) AS average_hours,
    ROUND(MIN((julianday(end_time) - julianday(start_time)) * 24), 2) AS shortest_hours,
    ROUND(MAX((julianday(end_time) - julianday(start_time)) * 24), 2) AS longest_hours
FROM trips
WHERE (julianday(end_time) - julianday(start_time)) * 1440 &gt; 1
	AND (julianday(end_time) - julianday(start_time)) * 24 &lt; 6;
	
SELECT
    COUNT(*) AS all_trips,
    COUNT(CASE WHEN bike_type = 'electric' THEN 1 END) AS electric_trips,
    ROUND(
        COUNT(CASE WHEN bike_type = 'electric' THEN 1 END) * 100 / COUNT(*),
        1
    ) AS pct_electric
FROM trips;</sql><current_tab id="0"/></tab_sql></sqlb_project>
